
{
  "name": "polilims",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión de laboratorio más avanzado del mundo",
  "keywords": ["LIMS", "laboratorio", "gestión", "calidad", "ensayos", "análisis"],
  "author": "PoliLims Team",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev --turbo",
    "dev:fast": "cross-env NODE_ENV=development next dev --turbo --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy preview",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true next build",
    "build:analyze": "cross-env ANALYZE=true next build",
    "perf:test": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "perf:audit": "npm run build && npm run perf:test"
  },
