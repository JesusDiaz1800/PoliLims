  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+polilims",
      "url": "/?protocol=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "application/pdf": [".pdf"],
        "image/*": [".png", ".jpg", ".jpeg", ".gif"],
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "application/pdf", "text/csv"]
        }
      ]
    }
  },
  "handle_links": "preferred",
  "scope_extensions": [
    {
      "origin": "https://api.polilims.com"
    }
  ],
  "capture_links": "existing-client-navigate",
  "permissions": [
    "notifications",
    "background-sync",
    "storage"
  ],
  "background": {
    "service_worker": "/sw.js",
    "type": "module"
  },
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "description": "PoliLims es el sistema de gestión de laboratorio más avanzado del mundo, diseñado para optimizar el control de calidad y la gestión de ensayos en laboratorios de todo tipo.",
  "author": "PoliLims Team",
  "version": "1.0.0",
  "homepage_url": "https://polilims.com",
  "developer": {
    "name": "PoliLims Development Team",
    "url": "https://polilims.com/developers"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polilims/polilims"
  },
  "bugs": {
    "url": "https://github.com/polilims/polilims/issues"
  },
  "keywords": [
    "LIMS",
    "laboratorio",
    "gestión",
    "calidad",
    "ensayos",
    "análisis",
    "control",
    "productividad"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
