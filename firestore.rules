rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla de seguridad predeterminada: denegar todo el acceso.
    // Esto asegura que ninguna colección sea accesible a menos que se defina una regla explícita.
    match /{document=**} {
      allow read, write: if false;
    }

    // Permitir a los usuarios autenticados leer y escribir en sus propios datos de usuario.
    // NOTA: En producción, es posible que desee restringir las escrituras para que los usuarios no puedan cambiar sus propios roles.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Permitir que cualquier usuario autenticado lea datos que no son específicos del usuario, como la lista de equipos o ensayos.
    // Las escrituras deben restringirse a roles específicos.
    match /ensayos/{ensayoId} {
      allow read: if request.auth != null;
      // Permitir la escritura solo a 'Analistas' o 'Jefes'. Esto requeriría que el rol del usuario
      // se almacene en los custom claims del token de autenticación o en una colección 'users'.
      // Ejemplo (requiere configuración adicional): allow write: if request.auth.token.role in ['analista', 'jefe_calidad'];
      allow write: if request.auth != null; // Simplificado para el prototipo
    }

    match /equipos/{equipoId} {
      allow read: if request.auth != null;
      // Ejemplo: allow write: if request.auth.token.role in ['admin', 'jefe_calidad'];
      allow write: if request.auth != null; // Simplificado para el prototipo
    }

    match /registros_control_rutinario/{registroId} {
        allow read, write: if request.auth != null; // Abierto para inspectores y analistas
    }

     match /controles_equipos/{controlId} {
        allow read, write: if request.auth != null;
    }
    
    match /no_conformidades/{incidenciaId} {
        allow read, write: if request.auth != null;
    }

     match /importaciones/{importacionId} {
        allow read, write: if request.auth != null;
    }

    match /generated_reports/{reportId} {
        allow read, write: if request.auth != null;
    }


    // El historial de actividad (audit trail) solo debe ser de escritura. Nadie debería poder modificar o eliminar registros.
    match /recent_activity/{activityId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false; // Los registros de auditoría son inmutables.
    }
  }
}
