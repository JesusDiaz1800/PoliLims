# Configuración del Frontend Next.js

# URL del backend Django
NEXT_PUBLIC_API_URL=http://localhost:8000

# Configuración de la aplicación
NEXT_PUBLIC_APP_NAME=PoliLims
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_DESCRIPTION=Sistema de Gestión de Laboratorio

# Configuración de autenticación
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_JWT_ACCESS_TOKEN_EXPIRY=3600
NEXT_PUBLIC_JWT_REFRESH_TOKEN_EXPIRY=604800

# Configuración de caché
NEXT_PUBLIC_CACHE_ENABLED=true
NEXT_PUBLIC_CACHE_TTL=300000

# Configuración de notificaciones
NEXT_PUBLIC_NOTIFICATIONS_ENABLED=true
NEXT_PUBLIC_NOTIFICATION_DURATION=5000

# Configuración de monitoreo
NEXT_PUBLIC_MONITORING_ENABLED=true
NEXT_PUBLIC_PERFORMANCE_MONITORING=true

# Configuración de desarrollo
NEXT_PUBLIC_DEBUG_MODE=true
NEXT_PUBLIC_LOG_LEVEL=debug

# Configuración de características
NEXT_PUBLIC_REAL_TIME_UPDATES=true
NEXT_PUBLIC_OFFLINE_MODE=false
NEXT_PUBLIC_PWA_ENABLED=true

# Configuración de exportación
NEXT_PUBLIC_EXPORT_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_EXPORT_ALLOWED_FORMATS=excel,pdf,csv,json

# Configuración de paginación
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=20
NEXT_PUBLIC_MAX_PAGE_SIZE=100

# Configuración de búsqueda
NEXT_PUBLIC_SEARCH_MIN_LENGTH=2
NEXT_PUBLIC_SEARCH_DEBOUNCE_DELAY=300
NEXT_PUBLIC_SEARCH_MAX_RESULTS=10

# Configuración de sesión
NEXT_PUBLIC_SESSION_TIMEOUT=28800000
NEXT_PUBLIC_AUTO_LOGOUT_ENABLED=true

# Configuración de temas
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_THEME_PERSISTENCE=true

# Configuración de idioma
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_AVAILABLE_LOCALES=es,en

# Configuración de zona horaria
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/Bogota

# Configuración de formato de fechas
NEXT_PUBLIC_DATE_FORMAT=DD/MM/YYYY
NEXT_PUBLIC_TIME_FORMAT=HH:mm:ss
NEXT_PUBLIC_DATETIME_FORMAT=DD/MM/YYYY HH:mm:ss

# Configuración de moneda
NEXT_PUBLIC_DEFAULT_CURRENCY=COP
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Configuración de unidades
NEXT_PUBLIC_DEFAULT_UNITS=metric
NEXT_PUBLIC_WEIGHT_UNIT=kg
NEXT_PUBLIC_LENGTH_UNIT=m
NEXT_PUBLIC_VOLUME_UNIT=L

# Configuración de validación
NEXT_PUBLIC_VALIDATION_STRICT_MODE=true
NEXT_PUBLIC_SHOW_VALIDATION_ERRORS=true

# Configuración de accesibilidad
NEXT_PUBLIC_ACCESSIBILITY_ENABLED=true
NEXT_PUBLIC_HIGH_CONTRAST_MODE=false
NEXT_PUBLIC_SCREEN_READER_SUPPORT=true

# Configuración de rendimiento
NEXT_PUBLIC_LAZY_LOADING_ENABLED=true
NEXT_PUBLIC_VIRTUAL_SCROLLING_ENABLED=true
NEXT_PUBLIC_INFINITE_SCROLL_ENABLED=true

# Configuración de seguridad
NEXT_PUBLIC_CSRF_PROTECTION=true
NEXT_PUBLIC_XSS_PROTECTION=true
NEXT_PUBLIC_CONTENT_SECURITY_POLICY=true

# Configuración de analytics
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ID=

# Configuración de errores
NEXT_PUBLIC_ERROR_REPORTING_ENABLED=true
NEXT_PUBLIC_ERROR_REPORTING_URL=

# Configuración de logs
NEXT_PUBLIC_LOGGING_ENABLED=true
NEXT_PUBLIC_LOG_TO_CONSOLE=true
NEXT_PUBLIC_LOG_TO_REMOTE=false

# Configuración de desarrollo específica
NEXT_PUBLIC_MOCK_DATA_ENABLED=false
NEXT_PUBLIC_API_MOCKING_ENABLED=false
NEXT_PUBLIC_FAKE_API_DELAY=0

# Configuración de pruebas
NEXT_PUBLIC_TEST_MODE=false
NEXT_PUBLIC_TEST_USER_ID=
NEXT_PUBLIC_TEST_USER_ROLE=

# Configuración de características experimentales
NEXT_PUBLIC_EXPERIMENTAL_FEATURES=false
NEXT_PUBLIC_BETA_FEATURES=false
NEXT_PUBLIC_ALPHA_FEATURES=false

# Configuración de integración
NEXT_PUBLIC_INTEGRATION_MODE=false
NEXT_PUBLIC_EXTERNAL_API_ENABLED=false
NEXT_PUBLIC_WEBHOOK_ENABLED=false

# Configuración de backup
NEXT_PUBLIC_AUTO_BACKUP_ENABLED=false
NEXT_PUBLIC_BACKUP_INTERVAL=86400000

# Configuración de sincronización
NEXT_PUBLIC_SYNC_ENABLED=true
NEXT_PUBLIC_SYNC_INTERVAL=30000
NEXT_PUBLIC_OFFLINE_SYNC_ENABLED=false

# Configuración de notificaciones push
NEXT_PUBLIC_PUSH_NOTIFICATIONS_ENABLED=false
NEXT_PUBLIC_PUSH_PUBLIC_KEY=

# Configuración de chat en vivo
NEXT_PUBLIC_LIVE_CHAT_ENABLED=true
NEXT_PUBLIC_CHAT_WIDGET_ENABLED=true

# Configuración de ayuda
NEXT_PUBLIC_HELP_ENABLED=true
NEXT_PUBLIC_TUTORIAL_ENABLED=true
NEXT_PUBLIC_CONTEXT_HELP_ENABLED=true

# Configuración de documentación
NEXT_PUBLIC_DOCS_ENABLED=true
NEXT_PUBLIC_API_DOCS_ENABLED=true
NEXT_PUBLIC_USER_GUIDE_ENABLED=true

# Configuración de soporte
NEXT_PUBLIC_SUPPORT_ENABLED=true
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@polilims.com
NEXT_PUBLIC_SUPPORT_PHONE=+57-1-123-4567

# Configuración de feedback
NEXT_PUBLIC_FEEDBACK_ENABLED=true
NEXT_PUBLIC_FEEDBACK_URL=

# Configuración de actualizaciones
NEXT_PUBLIC_AUTO_UPDATE_ENABLED=false
NEXT_PUBLIC_UPDATE_CHECK_INTERVAL=3600000

# Configuración de mantenimiento
NEXT_PUBLIC_MAINTENANCE_MODE=false
NEXT_PUBLIC_MAINTENANCE_MESSAGE=

# Configuración de límites
NEXT_PUBLIC_MAX_FILE_UPLOAD_SIZE=10485760
NEXT_PUBLIC_MAX_BATCH_OPERATIONS=100
NEXT_PUBLIC_MAX_SEARCH_RESULTS=1000

# Configuración de caché del navegador
NEXT_PUBLIC_BROWSER_CACHE_ENABLED=true
NEXT_PUBLIC_SERVICE_WORKER_ENABLED=true
NEXT_PUBLIC_CACHE_STRATEGY=stale-while-revalidate

# Configuración de optimización
NEXT_PUBLIC_IMAGE_OPTIMIZATION_ENABLED=true
NEXT_PUBLIC_FONT_OPTIMIZATION_ENABLED=true
NEXT_PUBLIC_BUNDLE_ANALYZER_ENABLED=false

# Configuración de desarrollo local
NEXT_PUBLIC_DEV_SERVER_PORT=3000
NEXT_PUBLIC_DEV_SERVER_HOST=localhost
NEXT_PUBLIC_DEV_TOOLS_ENABLED=true

# Configuración de producción
NEXT_PUBLIC_PRODUCTION_MODE=false
NEXT_PUBLIC_BUILD_OPTIMIZATION=true
NEXT_PUBLIC_COMPRESSION_ENABLED=true

# Configuración de CDN
NEXT_PUBLIC_CDN_ENABLED=false
NEXT_PUBLIC_CDN_URL=

# Configuración de monitoreo de errores
NEXT_PUBLIC_ERROR_BOUNDARY_ENABLED=true
NEXT_PUBLIC_ERROR_FALLBACK_ENABLED=true

# Configuración de pruebas de conectividad
NEXT_PUBLIC_CONNECTIVITY_CHECK_ENABLED=true
NEXT_PUBLIC_CONNECTIVITY_CHECK_INTERVAL=30000

# Configuración de métricas de rendimiento
NEXT_PUBLIC_PERFORMANCE_METRICS_ENABLED=true
NEXT_PUBLIC_WEB_VITALS_ENABLED=true
NEXT_PUBLIC_CORE_WEB_VITALS_ENABLED=true
